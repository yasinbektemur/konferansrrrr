{
  "name": "konferans-cagrisi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next typegen && tsc --noEmit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:doctor": "node --import tsx scripts/db-doctor.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "db:restore": "node --import tsx scripts/restore.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7",
    "@next/env": "16.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
